# Carregar explicitamente com node --env-file=.env.test scripts/test-live.mjs ...
# A bateria offline não carrega este arquivo.
META_LIVE_ACCESS_TOKEN=
META_LIVE_API_VERSION=v26.0

# Para validar o deploy HTTP, use o Bearer OAuth do próprio MCP.
# Um token Meta sozinho não autentica o transporte HTTP.
META_LIVE_MCP_URL=
META_LIVE_MCP_BEARER=
