# Local stdio: token is provided by the MCP client environment.
META_ACCESS_TOKEN=
META_API_VERSION=v26.0

# Remote HTTP: each user supplies their Meta token in the connection screen.
# Use a NEW database; never reuse the existing v1 database.
DATABASE_URL=
MCP_ENCRYPTION_KEY=
# Generate an independent key: openssl rand -hex 32
MCP_BASE_URL=http://localhost:3000
PORT=3000
# Optional accelerated OAuth renewal testing: integer seconds from 60 to 3600.
# Unset defaults to 3600 (one hour). Only newly issued/renewed tokens are affected.
# MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=120
# Railway supplies RAILWAY_PUBLIC_DOMAIN and proxy environment automatically.
# For another trusted reverse proxy, set TRUST_PROXY=1.
